NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lights / automations: only set on the LOCAL instance (running on your home LAN)
# Leave unset on Vercel — those pages will render but won't try to broadcast UDP.
LIGHTS_ENABLED=
WIZ_BROADCAST=192.168.39.255
WIZ_PORT=38899
